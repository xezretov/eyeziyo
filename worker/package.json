{
  "name": "tatuziyo-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0 --port 8788",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute tatuziyo-db --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute tatuziyo-db --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
